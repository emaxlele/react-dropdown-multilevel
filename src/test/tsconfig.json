{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"emitDeclarationOnly": false,
		"noEmit": true,
		"types": ["vite/client", "node"],
		"baseUrl": "../..",
		"paths": {
			"@root/*": ["./*"],
			"@src/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@hooks/*": ["src/hooks/*"],
			"@styles/*": ["src/styles/*"],
			"@utility/*": ["src/utility/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "../types/vite-env.d.ts"]
}
