{
    "name": "react-dropdown-multilevel",
    "version": "0.1.0",
    "description": "ReactJS multilevel dropdown component",
    "type": "module",
    "author": "emaxlele <emaxlele97@gmail.com>",
    "license": "Apache-2.0",
    "homepage": "https://github.com/emaxlele/react-dropdown-multilevel-master",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/emaxlele/react-dropdown-multilevel-master.git"
    },
    "keywords": [
        "reactjs",
        "react",
        "react dropdown",
        "multilevel dropdown",
        "dropdown multilevel",
        "react multilevel",
        "react form",
        "form",
        "dropdown",
        "react multilevel dropdown",
        "emaxlele"
    ],
    "bugs": {
        "url": "https://github.com/emaxlele/react-dropdown-multilevel-master/issues"
    },
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "typings": "./dist/types/index.d.ts",
    "types": "./dist/types/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        }
    },
    "files": [
        "./dist"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "copy_files": "copyfiles -u 1 dist/index.css dist/esm && copyfiles -u 1 dist/index.css dist/types",
        "build_tsc": "npm run clean && npm run build:esm && npm run build:types && npx tailwindcss build -o dist/index.css && npm run copy_files",
        "build:cjs": "tsc --module commonjs --outDir dist/cjs --declaration false",
        "build:esm": "tsc --module es6 --outDir dist/esm --declaration false",
        "build:types": "tsc --emitDeclarationOnly true --declarationDir dist/types",
        "watch": "tsc -w",
        "dev": "vite",
        "build": "npm run clean && vite build",
        "build_with_tsc": "npm run clean && vite build && tsc --emitDeclarationOnly --declarationDir dist/types",
        "serve": "vite preview"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/styled-components": "^5.1.34",
        "@typescript-eslint/eslint-plugin": "^8.16.0",
        "@typescript-eslint/parser": "^8.16.0",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "copyfiles": "^2.4.1",
        "eslint": "^9.15.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "postcss": "^8.4.49",
        "rimraf": "^6.0.1",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.7.2",
        "vite": "^6.0.1",
        "vite-plugin-checker": "^0.8.0",
        "vite-plugin-css-injected-by-js": "^3.5.2",
        "vite-plugin-dts": "^4.3.0"
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "engines": {
        "node": ">=18"
    }
}
