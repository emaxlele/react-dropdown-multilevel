{
	"name": "react-dropdown-multilevel",
	"version": "1.0.0",
	"description": "ReactJS multilevel dropdown component",
	"type": "module",
	"module": "./index.js",
	"types": "./index.d.ts",
	"sideEffects": [
		"**/*.css"
	],
	"author": "emaxlele <emaxlele97@gmail.com>",
	"license": "Apache-2.0",
	"homepage": "https://github.com/emaxlele/react-dropdown-multilevel-master",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emaxlele/react-dropdown-multilevel-master.git"
	},
	"keywords": [
		"reactjs",
		"react",
		"react dropdown",
		"multilevel dropdown",
		"dropdown multilevel",
		"react multilevel",
		"react form",
		"form",
		"dropdown",
		"react multilevel dropdown",
		"emaxlele"
	],
	"bugs": {
		"url": "https://github.com/emaxlele/react-dropdown-multilevel-master/issues"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		}
	},
	"files": [
		"**/*"
	],
	"packageManager": "pnpm@11.5.1",
	"scripts": {
		"clean": "rimraf dist",
		"dev": "vite",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"build": "pnpm clean && vite build && node scripts/prepare-dist-package.js",
		"pack:lib": "pnpm build && cd dist && npm pack",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "vitest run && playwright test"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.3.3",
		"@types/react": "^19.2.1",
		"@types/react-dom": "^19.2.1",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"eslint": "^10.4.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"jsdom": "^28.1.0",
		"lucide-react": "^1.17.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"rimraf": "^6.0.1",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.3",
		"vite": "^7.2.4",
		"vite-plugin-checker": "^0.12.0",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.18",
		"zustand": "^5.0.8"
	},
	"engines": {
		"node": ">=22.10.0"
	}
}
