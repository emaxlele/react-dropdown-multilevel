{
    "name": "react-dropdown-multilevel",
    "version": "0.0.1",
    "description": "ReactJS multilevel dropdown component",
    "type": "module",
    "module": "./index.js",
    "types": "./index.d.ts",
    "author": "emaxlele <emaxlele97@gmail.com>",
    "license": "Apache-2.0",
    "homepage": "https://github.com/emaxlele/react-dropdown-multilevel-master",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/emaxlele/react-dropdown-multilevel-master.git"
    },
    "keywords": [
        "reactjs",
        "react",
        "react dropdown",
        "multilevel dropdown",
        "dropdown multilevel",
        "react multilevel",
        "react form",
        "form",
        "dropdown",
        "react multilevel dropdown",
        "emaxlele"
    ],
    "bugs": {
        "url": "https://github.com/emaxlele/react-dropdown-multilevel-master/issues"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js"
        }
    },
    "files": [
        "**/*"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "copy_files1": "copyfiles -u 1 dist/index.css dist/esm && copyfiles -u 1 dist/index.css dist/types",
        "build_tsc": "npm run clean && npm run build:esm && npm run build:types && npx tailwindcss build -o dist/index.css && npm run copy_files",
        "build:cjs": "tsc --module commonjs --outDir dist/cjs --declaration false",
        "build:esm": "tsc --module es6 --outDir dist/esm --declaration false",
        "build:types": "tsc --emitDeclarationOnly true --declarationDir dist/types",
        "watch": "tsc -w",
        "build1": "npm run clean && vite build",
        "build_with_tsc": "npm run clean && vite build && tsc --emitDeclarationOnly --declarationDir dist/types",
        "serve": "vite preview",
        "copy_files": "copyfiles package.json dist",
        "build": "npm run clean && vite build && node scripts/prepare-dist-package.js && cd dist && npm pack",
        "dev": "vite --open",
        "test": "http-server --port 8080",
        "test:unit": "vitest",
        "test:unit:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "vitest run && playwright test"
    },
    "peerDependencies": {
        "react": ">=19.2.1",
        "react-dom": ">=19.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/vite": "^4.1.17",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.3.3",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/styled-components": "^5.1.34",
        "@typescript-eslint/eslint-plugin": "^8.16.0",
        "@typescript-eslint/parser": "^8.16.0",
        "@vitejs/plugin-react": "^5.1.4",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "copyfiles": "^2.4.1",
        "eslint": "^9.39.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^28.1.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "rimraf": "^6.0.1",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3",
        "vite": "^7.2.4",
        "vite-plugin-checker": "^0.12.0",
        "vite-plugin-css-injected-by-js": "^4.0.1",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.0.18"
    },
    "engines": {
        "node": ">=22.10.0"
    }
}
