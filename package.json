{
  "name": "react-dropdown-multilevel",
  "version": "0.1.0",
  "description": "ReactJS multilevel dropdown component",
  "author": "emaxlele <emaxlele97@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/emaxlele/react-dropdown-multilevel-master",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxlele/react-dropdown-multilevel-master.git"
  },
  "keywords": [
    "reactjs",
    "react",
    "react dropdown",
    "multilevel dropdown",
    "dropdown multilevel",
    "react multilevel",
    "react form",
    "form",
    "dropdown",
    "react multilevel dropdown",
    "emaxlele"
  ],
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/emaxlele/react-dropdown-multilevel-master/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "clean": "if exist dist rmdir /s /q dist",
    "tsc": "tsc",
    "prepublishOnly": "yarn build",
    "dev": "yarn clean && tsc --watch",
    "build": "yarn clean && yarn build:cjs && yarn build:esm && yarn build:types",
    "build:cjs": "tsc --module commonjs --outDir dist\\cjs\\ --declaration false",
    "build:esm": "tsc --module es6 --outDir dist\\esm\\ --declaration false",
    "build:types": "tsc --emitDeclarationOnly true --declarationDir dist\\types\\"
  },
  "peerDependencies": {
    "react": ">= 18.2.48",
    "react-dom": ">= 18.2.18"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/styled-components": "^5.1.34",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "extends": "react-app"
  }
}
