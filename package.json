{
  "name": "react-dropdown-multilevel",
  "version": "0.1.0",
  "description": "ReactJS multilevel dropdown component",
  "author": "emaxlele <emaxlele97@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/emaxlele/react-dropdown-multilevel-master",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxlele/react-dropdown-multilevel-master.git"
  },
  "keywords": [
    "reactjs",
    "react",
    "react dropdown",
    "multilevel dropdown",
    "dropdown multilevel",
    "react multilevel",
    "react form",
    "form",
    "dropdown",
    "react multilevel dropdown",
    "emaxlele"
  ],
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/emaxlele/react-dropdown-multilevel-master/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "bild": "yarn clean && yarn tsc && webpack --mode production",
    "boh": "yarn clean && yarn tsc --module es6 --outDir dist --declaration false && yarn tsc --emitDeclarationOnly true --declarationDir dist",
    "dev_webpack": "webpack --mode development --watch",
    "build_webpack": "yarn clean && webpack --mode production",
    "build_tsc": "yarn build:cjs && yarn build:esm && yarn build:types && npx tailwindcss build -o dist\\style.css && yarn copy_file ",
    "copy_file": "copy package.json dist && copy dist\\index.css dist\\esm\\index.css && copy dist\\index.css dist\\cjs\\index.css && copy dist\\index.css dist\\types\\index.css",
    "clean": "if exist dist rmdir /s /q dist",
    "tsc": "tsc",
    "prepublishOnly": "yarn build",
    "dev": "yarn clean && tsc",
    "build": "yarn clean && yarn build:cjs && yarn build:esm && yarn build:types && npx tailwindcss build -o dist\\style.css",
    "build:cjs": "tsc --module commonjs --outDir dist\\cjs\\ --declaration false",
    "build:esm": "tsc --module es6 --outDir dist\\esm\\ --declaration false",
    "build:types": "tsc --emitDeclarationOnly true --declarationDir dist\\types\\",
    "clean_linux": "rm -rf dist",
    "prepublishOnly_linux": "yarn build_linux",
    "dev_linux": "yarn clean_linux && tsc --watch",
    "build_linux": "yarn clean_linux && yarn build:cjs_linux && yarn build:esm_linux && yarn build:types_linux && npx tailwindcss build -o dist/style.css",
    "build:cjs_linux": "tsc --module commonjs --outDir dist/cjs/ --declaration false",
    "build:esm_linux": "tsc --module es6 --outDir dist/esm/ --declaration false",
    "build:types_linux": "tsc --emitDeclarationOnly true --declarationDir dist/types/"
  },
  "peerDependencies": {
    "react": ">= 17.0.2",
    "react-dom": ">= 17.0.2",
    "typescript": ">= 2.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "@babel/preset-react": "^7.23.3",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/styled-components": "^5.1.34",
    "autoprefixer": "^10.4.17",
    "babel-loader": "^9.1.3",
    "babel-preset-env": "^1.7.0",
    "babel-preset-react": "^6.24.1",
    "css-loader": "^6.9.1",
    "mini-css-extract-plugin": "^2.7.7",
    "postcss": "^8.4.33",
    "postcss-cli": "^11.0.0",
    "postcss-loader": "^8.0.0",
    "prettier": "^3.2.4",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "dependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "webpack-shell-plugin": "^0.5.0",
    "webpack-shell-plugin-next": "^2.3.1"
  }
}
